# Copy this file to .env and fill in real values. NEVER commit .env.
#
# These same variables must be configured in Vercel:
#   Project -> Settings -> Environment Variables
# (Production / Preview / Development)

# Your Supabase project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=

# Server-side key. Use the SECRET key (service role) so the API can read and
# write all tables. Never expose this in the browser.
SUPABASE_KEY=

# Password used to log in to the /admin dashboard.
ADMIN_PASSWORD=
